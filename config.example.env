# Larkyard / ticketd 个人配置。复制到 ~/.ticketd/config.env 后按需修改（scripts/install.sh 会自动复制一份）。
# 一行一个 KEY=VALUE；同名环境变量优先于这里。这个文件含个人信息，不要提交到仓库。

# 必填：主用户的飞书 open_id（ou_ 开头）。只为这个人发起的消息派单。
# 查法：在飞书里给 bot 发一条消息，bridge 注入的 <bridge_context> 里的 senderId 就是。
TICKETD_OWNER=

# 工单目录的根（每张单一个子目录，worker 在里面干活、交付产物）。不要放在 /tmp 下。
# TICKETD_WORKROOT=~/larkyard-tickets

# 同时跑几个 worker、单轮超时（秒）、worker 用的模型（留空用 claude 的默认模型）
# TICKETD_MAX_WORKERS=3
# TICKETD_TURN_TIMEOUT=7200
# TICKETD_MODEL=

# Codex 执行器（ticket new --executor codex，或把 TICKETD_EXECUTOR 设为 codex）
# TICKETD_EXECUTOR=claude
# TICKETD_CODEX=/absolute/path/to/codex
# TICKETD_CODEX_MODEL=
# TICKETD_CODEX_HOME=~/.ticketd/codex-home
# TICKETD_CODEX_GIT_WRITABLE=1

# 结果里的 .mp4 视频以你的身份传到你的飞书云空间，结果卡里点开播放。留空 = 云空间根目录；
# 想集中放到某个文件夹，填该文件夹的 token（打开文件夹，链接 /drive/folder/ 后面那串）。
# TICKETD_VIDEO_FOLDER=

# 媒体通道最多同时准备几张结果卡（图片/视频上传、稿子导入、视频消息）。不同工单之间并行，同一工单仍按顺序。
# TICKETD_MEDIA_WORKERS=2
# 其中最多几个在传视频（大文件占带宽和内存，也容易撞飞书限流）；不超过上面的总数。
# TICKETD_MEDIA_VIDEO_WORKERS=1

# 可执行文件（不在 PATH 上时写绝对路径）
# TICKETD_CLAUDE=claude
# TICKETD_LARK=lark-cli

# 状态卡节奏（秒）：无变化时的刷新间隔、追问轮次多久没结果才补发状态卡、多久没动作算疑似卡住、交了终态汇报后进程还挂着多久就结束它
# TICKETD_CARD_HEARTBEAT=150
# TICKETD_ROUND_CARD_DELAY=120
# TICKETD_STALL_SECONDS=600
# 卡住分级处置（秒，从最后一个动作算起，0 = 关）：这次命令的进程没在消耗 CPU 时先结束它们、worker 收到报错接着做；仍没进展就中止这一轮报 blocked
# TICKETD_STALL_INTERRUPT=1800
# TICKETD_STALL_ABORT=3600
# TICKETD_LINGER_GRACE=60

# 临时失败的重试间隔（秒，逗号分隔）
# TICKETD_RETRY_DELAYS=10,40,160

# worker 和沙箱外执行的脚本的补充环境：服务由 launchd / systemd 托管，PATH 比登录 shell 短
# TICKETD_WORKER_PATH 追加到 PATH（冒号分隔）；TICKETD_WORKER_ENV 是变量名白名单，值从本文件或服务环境里取
# 注意：Claude Code 沙箱里的命令一律走它自己的本机代理，这里传的 *_PROXY 到不了沙箱里的命令
# TICKETD_WORKER_PATH=/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin
# TICKETD_WORKER_ENV=NPM_CONFIG_REGISTRY,HTTPS_PROXY
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# 沙箱外执行（用户批准后由 ticketd 运行 worker 申请的脚本）最长多少秒
# TICKETD_RUN_TIMEOUT=1800

# 故障等待：短重试用完的网络/接口故障，以及余额不足、认证失败，每隔多久（秒）自动续跑、最长多少小时（0 = 不等，直接失败）
# TICKETD_OUTAGE_RETRY_EVERY=900
# TICKETD_OUTAGE_RETRY_HOURS=24
